␀␀␀async function cp(p){try{let d=prompt('е¤Ќе€¶е€°ж–‡д»¶е¤№пј€з›ёеЇ№еЅ“е‰Ќз›з¬¦пј‰',dir);if(d===null)return;await api('/webfm/copy',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'path='+enc(p)+'&dest='+enc(d)});load()}catch(e){status(e.message,true)}}␀␀␀async function del(p){try{if(!confirm('зЎ®е®ље€ й™¤ '+p+' еђ—пјџ'))return;await api('/webfm/delete',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'path='+enc(p)});load()}catch(e){status(e.message,true)}}␀␀async function edit(p){try{editPath=p;el('editName').textContent=p;let r=await fetch('/webfm/read?path='+enc(p));let t=await r.text();if(!r.ok)throw new Error(t||r.status);let code=r.headers.get('X-Text-Encoding')||'UTF-8';el('editEncoding').textContent='зј–з Ѓ: '+code+(code.startsWith('UTF-8')?'':'пјЊдїќе­еђЋиЅ¬дёє UTF-8');el('editText').value=t;el('editor').classList.add('active');el('editText').focus()}catch(e){status(e.message,true)}}␀async function load(){try{status('ж­ЈењЁеЉ иЅЅ...');let r=await fetch('/webfm/list?dir='+enc(dir));if(!r.ok)throw new Error(await r.text()||r.status);let j=await r.json();items=j.items||[];items.sort((a,b)=>b.dir-a.dir||a.name.localeCompare(b.name));if(items.length&&kbActive&&sel<0)sel=0;if(sel>=items.length)sel=items.length-1;el('path').textContent='/' + dir;history.replaceState(null,'','/webfm'+(dir?'?dir='+enc(dir):''));render()}catch(e){status(e.message,true)}}␀␀␀async function ren(p){try{let n=prompt('ж–°еђЌз§°',p.split('/').pop());if(!n)return;await api('/webfm/rename',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'path='+enc(p)+'&name='+enc(n)});load()}catch(e){status(e.message,true)}}␀␀␀␀async function saveEdit(){try{let r=await fetch('/webfm/save?path='+enc(editPath),{method:'POST',body:el('editText').value});if(!r.ok)throw new Error(await r.text()||r.status);status('е·Ідїќе­ '+editPath);load()}catch(e){status(e.message,true)}}␀␀async function upload(){let fs=[...el('file').files];if(!fs.length)return;try{let ok=0;for(let i=0;i<fs.length;i++){await uploadOne(fs[i],i,fs.length);ok++;await upSleep(180)}el('uploadStatus').textContent=`дёЉдј е®Њж€ђпјљ${ok}/${fs.length}`;setTimeout(()=>{closeUploadModal();load()},500)}catch(e){status(e.message,true);el('uploadStatus').textContent=e.message}}␀␀␀␀async function uploadOne(f,i,n){if(f.size===0){await uploadFetch('/webfm/upload?dir='+enc(dir)+'&name='+enc(f.name)+'&offset=0&total=0',new Blob([]),f.name);return}for(let off=0;off<f.size;off+=UP_CHUNK){let end=Math.min(f.size,off+UP_CHUNK),part=f.slice(off,end),pct=Math.floor(end*100/f.size);el('uploadStatus').textContent=`ж­ЈењЁдёЉдј  (${i+1}/${n}) ${pct}% ${f.name}`;await uploadFetch('/webfm/upload?dir='+enc(dir)+'&name='+enc(f.name)+'&offset='+off+'&total='+f.size,part,f.name);await upSleep(30)}}␀␀function ext(n){let i=n.lastIndexOf('.');return i<0?'':n.slice(i+1).toLowerCase()}function isImg(n){return ['jpg','jpeg','png','gif','bmp'].includes(ext(n))}function isText(n){return ['txt','log','md','json','ini','cfg','conf','csv','c','h','cpp','hpp','py','js','html','css','xml','yaml','yml'].includes(ext(n))}function kind(it){if(it.dir)return['ж–‡д»¶е¤№','dir',icoDir()];let e=ext(it.name);if(isImg(it.name))return['е›ѕз‰‡','image',icoImg()];if(['mp3','wav','flac','aac','ogg'].includes(e))return['йџійў‘','audio',icoAud()];if(['mp4','avi','mov','mkv'].includes(e))return['и§†йў‘','video',icoVid()];if(['zip','gz','tar','rar','7z'].includes(e))return['еЋ‹зј©еЊ…','archive',icoArc()];if(isText(it.name))return[e||'ж–‡жњ¬','code',icoCode()];return[e||'ж–‡д»¶','',icoFile()]}␀␀␀function pager(tp){let html=`<button ${page<=1?'disabled':''} onclick='goPage(1)'>й¦–йЎµ</button><button ${page<=1?'disabled':''} onclick='goPage(page-1)'>дёЉдёЂйЎµ</button>`;let b=Math.max(1,page-2),e=Math.min(tp,page+2);for(let p=b;p<=e;p++)html+=`<button class='${p===page?'active':''}' onclick='goPage(${p})'>${p}</button>`;html+=`<button ${page>=tp?'disabled':''} onclick='goPage(page+1)'>дё‹дёЂйЎµ</button><button ${page>=tp?'disabled':''} onclick='goPage(${tp})'>жњ«йЎµ</button>`;el('topPager').innerHTML=tp>1?html:'';el('bottomPager').innerHTML=tp>1?html:''}function goPage(p){page=p;if(items.length)sel=Math.min((page-1)*pageSize,items.length-1);render();syncSel(true)}␀␀function refresh(){fetch('/api/sysinfo').then(r=>r.json()).then(d=>{c_sys.innerHTML=R('иЉЇз‰‡ећ‹еЏ·',d.chip)+R('IDF з‰€жњ¬',d.idf_ver)+R('CPU йў‘зЋ‡',d.cpu_mhz+' MHz')+R('Flash',d.flash_mb+' MB')+R('иїђиЎЊж—¶й—ґ',d.uptime);c_net.innerHTML=R('WiFi зЉ¶жЂЃ',d.wifi_status)+R('SSID',d.wifi_ssid)+R('IPv4',d.wifi_ipv4)+R('IPv6',d.wifi_ipv6)+R('RSSI',d.wifi_rssi)+R('дїЎйЃ“',d.wifi_channel);c_mem.innerHTML=R('DRAM еЏЇз”Ё',d.heap_dram_free_kb+' KB')+R('DRAM жЂ»и®Ў',d.heap_dram_total_kb+' KB')+R('DMA еЏЇз”Ё',d.dma_free_kb+' KB')+R('DMA жЂ»и®Ў',d.dma_total_kb+' KB')+R('PSRAM еЏЇз”Ё',d.psram_free_kb+' KB')+R('PSRAM жЂ»и®Ў',d.psram_total_kb+' KB');c_tf.innerHTML=lines(d.tf_text);c_board.innerHTML=lines(d.board_text);ts.textContent=new Date().toLocaleTimeString()+' е·Іж›ґж–°'}).catch(()=>{ts.textContent='иїћжЋҐе¤±иґҐ'})}refresh();setInterval(refresh,2000);␀␀␀function render(){let total=items.length,tp=Math.max(1,Math.ceil(total/pageSize));if(total&&kbActive&&sel<0)sel=0;if(sel>=total)sel=total-1;if(!total)sel=-1;if(page>tp)page=tp;let start=(page-1)*pageSize,show=items.slice(start,start+pageSize),h='';show.forEach((it,local)=>{let i=start+local,p=full(it),k=kind(it);h+=`<tr data-i='${i}' class='${kbActive&&i===sel?'kb-focus':''}'><td><div class='name-cell'><span class='file-icon'>${k[2]}</span><div class='name-meta'><button class='name-title' data-act='open' data-i='${i}'>${esc(it.name)}</button><span class='name-sub'>/${esc(p)}</span></div></div></td><td><span class='chip ${k[1]}'>${k[0]}</span></td><td>${it.dir?'-':fmt(it.size)}</td><td><div class='actions'><button class='btn-secondary' data-act='open' data-i='${i}'>ж‰“ејЂ</button>`;if(!it.dir){h+=`<a class='btn' href='/webfm/download?path=${enc(p)}'>дё‹иЅЅ</a>`}h+=`<button class='btn-secondary' data-act='rename' data-i='${i}'>ж”№еђЌ</button><button class='btn-secondary' data-act='copy' data-i='${i}'>е¤Ќе€¶</button><button class='btn-secondary' data-act='move' data-i='${i}'>з§»еЉЁ</button><button class='btn-danger' data-act='delete' data-i='${i}'>е€ й™¤</button></div></td></tr>`});el('rows').innerHTML=h||\"<tr><td colspan='4' class='hint'>ж­¤ж–‡д»¶е¤№дёєз©єгЂ‚</td></tr>\";el('pageInfo').textContent=`е…± ${total} йЎ№пјЊжЇЏйЎµ ${pageSize} йЎ№пјЊз¬¬ ${page}/${tp} йЎµ`;pager(tp);status(total+' йЎ№')}␀␀␀function selectMoveDir(d){moveSelectedDir=d;document.querySelectorAll('#move_modal .tree-label.selected').forEach(x=>x.classList.remove('selected'));if(d==='')el('treeRootLabel').classList.add('selected');el('movePath').textContent='/' + d}async function openMoveModal(p,name){moveTarget=p;moveSelectedDir='';el('moveName').textContent=name;selectMoveDir('');el('move_modal').classList.add('active');await loadTree(el('treeRoot'),'')}function closeMoveModal(){el('move_modal').classList.remove('active');moveTarget=''}async function loadTree(c,d){c.innerHTML='<span class=\"hint\">еЉ иЅЅдё­...</span>';try{let r=await fetch('/webfm/dirtree?dir='+enc(d));let j=await r.json(),dirs=j.dirs||[];c.innerHTML='';if(!dirs.length){c.innerHTML='<span class=\"hint\">(з©є)</span>';return}dirs.forEach(name=>{let fp=d?d+'/'+name:name,n=document.createElement('div'),l=document.createElement('div'),ch=document.createElement('div');l.className='tree-label';l.innerHTML='<span class=\"tree-arrow\">&#9654;</span><span>'+esc(name)+'</span>';ch.className='tree-children';ch.style.display='none';let loaded=false;l.onclick=async e=>{e.stopPropagation();selectMoveDir(fp);l.classList.add('selected');if(!loaded){loaded=true;await loadTree(ch,fp)}let vis=ch.style.display!=='none';ch.style.display=vis?'none':'block';l.querySelector('.tree-arrow').innerHTML=vis?'&#9654;':'&#9660;'};n.appendChild(l);n.appendChild(ch);c.appendChild(n)})}catch(e){c.innerHTML='<span class=\"err\">еЉ иЅЅе¤±иґҐ</span>'}}async function confirmMove(){if(!moveTarget)return;try{await api('/webfm/move',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'path='+enc(moveTarget)+'&dest='+enc(moveSelectedDir)});closeMoveModal();load()}catch(e){status(e.message,true)}}␀␀␀␀if(event.key==='Enter')mkdir()\"></div><div class='modal-footer'><button class='btn-secondary' onclick='closeMkdirModal()'>еЏ–ж¶€</button><button onclick='mkdir()'>зЎ®и®¤е€›е»є</button></div></div></div>␀{\"chip\":\"%s (%u ж ё)\",\"idf_ver\":\"%s\",\"cpu_mhz\":%u,\"flash_mb\":\"%.2f\",\"uptime\":\"%s\",␀␀␀␀дёЉдј дё­зЁЌеђЋж’­ж”ѕ␀␀␀дёЉдј дё­пјЊжљ‚дёЌи§Јз Ѓе°Ѓйќў␀␀дёЉдј е¤±иґҐ␀␀␀␀дёЉдј иЊѓе›ґж— ж•€␀␀дё‹иЅЅдё­␀␀␀дё‹иЅЅе¤±иґҐпјљHTTP %d␀␀дё‹иЅЅж•°жЌ®и¶…иї‡жњЌеЉЎе™ЁеЈ°жЋе¤§е°Џ␀дё‹иЅЅзј“е†ІеЊєе†…е­дёЌи¶і␀дё‹иЅЅиї‡зЁ‹дё­иЇ»еЏ–е¤±иґҐпјљerrno=%d␀␀дё‹иЅЅиїћжЋҐй•їж—¶й—ґж— ж•°жЌ®␀␀дёЌж”ЇжЊЃзљ„йџійў‘ж јејЏ␀␀␀␀дёЌиѓЅжЉЉж–‡д»¶е¤№е¤Ќе€¶е€°и‡Єиє«е†…йѓЁ␀дёЌиѓЅжЉЉж–‡д»¶е¤№з§»еЉЁе€°и‡Єиє«е†…йѓЁ␀дёґж—¶ж–‡д»¶ж‰“ејЂе¤±иґҐ␀␀␀␀дё»жњє / IP␀дё»йў␀␀дє®и‰І␀␀д»…ж”ЇжЊЃ 16-bit PCM WAV␀␀␀␀дЅїз”Ё LVGL PNG/TJPGD и§Јз Ѓе™Ё␀дѕ‹е¦‚пјљbtop␀␀␀дѕ‹е¦‚пјљи…ѕи®Їдє‘␀␀дѕ›з”µжќҐжєђ␀␀␀␀дїќе­е¤±иґҐ␀␀␀␀дїќе­е¤±иґҐпјЊиЇ·жЈЂжџҐиѕ“е…ҐиЊѓе›ґгЂ‚␀дїќе­е№¶иїћжЋҐ␀дїЎжЃЇдёЌе®Њж•ґ␀е……з”µйЂџеє¦␀␀␀␀е…‰ењ€␀␀е…і␀е…¶д»–и®ѕзЅ®␀␀␀␀е†…е­дёЌи¶іпјЊж— жі•еЇје‡є␀е†™е…Ґ TF еЌЎе¤±иґҐ␀е†™е…Ґ UPLOAD е€†еЊєе¤±иґҐпјљ%s␀е†™е…ҐеЌ‡зє§иЇ·ж±‚е¤±иґҐ␀␀␀␀е†™е…Ґе¤‡д»Ѕж–‡д»¶е¤±иґҐ␀␀␀␀е†™е…ҐжњЌеЉЎе™Ёй…ЌзЅ®е¤±иґҐпјЊиЇ·зЁЌеђЋе†ЌиЇ•гЂ‚␀␀␀␀е‡†е¤‡ж’­ж”ѕ␀␀␀␀е‡†е¤‡ж›ґж–° UPLOAD е›єд»¶пјљ%.63s

