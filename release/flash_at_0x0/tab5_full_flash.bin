␀␀␀<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><link rel='icon' href='/favicon.ico' type='image/svg+xml'><title>е›ѕз‰‡жџҐзњ‹е™Ё</title><style>body{margin:0;background:#020617;color:#e5e7eb;font-family:system-ui,sans-serif;overflow:hidden}.bar{position:fixed;top:0;left:0;right:0;min-height:56px;background:#0f172acc;display:flex;align-items:center;gap:10px;padding:8px 12px;z-index:2;flex-wrap:wrap}button,.btn{font:inherit;border-radius:8px;border:1px solid #334155;background:#1e293b;color:#e5e7eb;padding:8px 12px;text-decoration:none;cursor:pointer}.name{flex:1 1 220px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#cbd5e1}.hint{color:#94a3b8;font-size:13px}.stage{position:absolute;inset:56px 0 0;display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:grab;touch-action:none}.stage.dragging{cursor:grabbing}img{max-width:100%;max-height:100%;transform-origin:center center;user-select:none;-webkit-user-drag:none;pointer-events:none;will-change:transform}.loading{position:absolute;inset:56px 0 0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;color:#cbd5e1;background:#020617;z-index:1}.loading.hidden{display:none}.spin{width:36px;height:36px;border:4px solid #334155;border-top-color:#60a5fa;border-radius:50%;animation:s 1s linear infinite}@keyframes s{to{transform:rotate(360deg)}}.loadmsg{font-size:15px}.loadmsg.err{color:#fca5a5}@media(max-width:760px){.bar{gap:6px}.bar button,.bar .btn{padding:7px 9px;font-size:14px}.hint{display:none}.stage,.loading{inset:92px 0 0}}</style></head><body><div class='bar'><button onclick='prev()'>дёЉдёЂеј </button><button onclick='next()'>дё‹дёЂеј </button><button onclick='rot()'>ж—‹иЅ¬</button><button onclick='resetView()'>йЂ‚еє”</button><a class='btn' id='downloadBtn'>дё‹иЅЅ</a><button onclick='closeView()'>е…ій—­</button><span class='name' id='name'></span><span class='hint'>ж»љиЅ®зј©ж”ѕпјЊж‹–ж‹Ѕз§»еЉЁ</span></div><div class='loading' id='loading'><div class='spin'></div><div class='loadmsg' id='loadmsg'>еЉ иЅЅдё­...</div></div><div class='stage' id='stage'><img id='img'></div><script>␀␀␀let cur="␀␀␀",dir="␀",returnDir="␀␀␀",items=[],shown=false,scale=1,angle=0,tx=0,ty=0,drag=false,sx=0,sy=0,stx=0,sty=0,objUrl='';const enc=encodeURIComponent,img=document.getElementById('img'),stage=document.getElementById('stage'),nameEl=document.getElementById('name'),downloadBtn=document.getElementById('downloadBtn'),loading=document.getElementById('loading'),loadmsg=document.getElementById('loadmsg');function file(){return cur.split('/').pop()}function apply(){img.style.transform=`translate(${tx}px,${ty}px) scale(${scale}) rotate(${angle}deg)`}function resetView(){scale=1;tx=0;ty=0;apply()}function setLoading(t,err=false){loadmsg.textContent=t;loadmsg.className='loadmsg '+(err?'err':'');loading.className='loading'}function hideLoading(){loading.className='loading hidden'}async function show(){shown=true;nameEl.textContent=cur;downloadBtn.href='/webfm/download?path='+enc(cur);resetView();setLoading('еЉ иЅЅдё­...');img.removeAttribute('src');if(objUrl){URL.revokeObjectURL(objUrl);objUrl=''}try{let r=await fetch('/webfm/image?path='+enc(cur));if(!r.ok)throw new Error(await r.text()||r.status);let b=await r.blob();objUrl=URL.createObjectURL(b);img.onload=()=>{hideLoading();resetView()};img.onerror=()=>setLoading('еЉ иЅЅе¤±иґҐ',true);img.src=objUrl}catch(e){setLoading('еЉ иЅЅе¤±иґҐ',true)}}function closeView(){if(objUrl)URL.revokeObjectURL(objUrl);location='/webfm'+(returnDir?'?dir='+enc(returnDir):'')}function loadList(){let listCtl=new AbortController(),listTimer=setTimeout(()=>listCtl.abort(),3000);fetch('/webfm/imglist?dir='+enc(dir),{signal:listCtl.signal}).then(r=>r.json()).then(j=>{items=j.items||[]}).catch(()=>{}).finally(()=>clearTimeout(listTimer))}function idx(){return items.indexOf(file())}function setBy(i){if(!items.length)return;i=(i+items.length)%items.length;cur=(dir?dir+'/':'')+items[i];angle=0;show()}function prev(){setBy(idx()-1)}function next(){setBy(idx()+1)}function rot(){angle=(angle+90)%360;apply()}stage.addEventListener('wheel',e=>{e.preventDefault();let old=scale;let next=Math.max(.15,Math.min(8,scale*(e.deltaY<0?1.12:.88)));let r=stage.getBoundingClientRect(),cx=e.clientX-r.left-r.width/2,cy=e.clientY-r.top-r.height/2;tx=cx-(cx-tx)*(next/old);ty=cy-(cy-ty)*(next/old);scale=next;apply()},{passive:false});function dragMove(e){if(!drag)return;tx=stx+e.clientX-sx;ty=sty+e.clientY-sy;apply()}function dragEnd(e){if(!drag)return;drag=false;stage.classList.remove('dragging');try{stage.releasePointerCapture(e.pointerId)}catch(_){}}stage.addEventListener('pointerdown',e=>{e.preventDefault();drag=true;sx=e.clientX;sy=e.clientY;stx=tx;sty=ty;stage.classList.add('dragging');try{stage.setPointerCapture(e.pointerId)}catch(_){}});stage.addEventListener('pointermove',dragMove);document.addEventListener('pointermove',dragMove);stage.addEventListener('pointerup',dragEnd);document.addEventListener('pointerup',dragEnd);stage.addEventListener('pointercancel',dragEnd);document.addEventListener('keydown',e=>{let k=e.key;if(k==='ArrowUp'||k==='ArrowLeft'){e.preventDefault();prev()}else if(k==='ArrowDown'||k==='ArrowRight'){e.preventDefault();next()}else if(k==='Enter'){e.preventDefault();rot()}else if(k==='Escape'){e.preventDefault();closeView()}});show();setTimeout(loadList,80);</script></body></html>␀␀␀{"dirs":[␀␀␀,"%s"␀␀␀]}␀␀%s"%s"␀␀W (%lu) %s: Web save failed: fopen tmp rel='%s' tmp='%s' errno=%d
